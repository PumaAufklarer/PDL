# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 构建产物
# 注意：这几条必须加前导 / 锚定到仓库根。
# 不锚定的 `data/` 会匹配任意层级的同名目录，把 `src/pdl/data/` 这类源码目录
# 一起忽略掉——本地因为文件已在磁盘上不会报错，一旦 clone 就 ModuleNotFoundError。
/data/
/dist/
/build/

# 工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# 数据集缓存（下载的数据放仓库根的 data/，不会影响 src/pdl/data/）
*.npz
*.npy

# 编辑器 / 系统
.idea/
.vscode/
.DS_Store

# Jupyter
.ipynb_checkpoints/
